#!/usr/bin/env bash
###############################################################################
# hs-hash-ui-password — generate a bcrypt hash for the UI Basic Auth password.
#
# Compose usage:
#   ./scripts/hs-hash-ui-password 'myPassword'
#   → paste into compose/.env as UI_BASIC_AUTH_HASH
#
# Kubernetes: the Helm chart hashes at render time — pass plaintext via
#   --set-string ui.basicAuth.password=...  or a values-*.yaml (under .gitignore)
###############################################################################
set -euo pipefail

PW="${1:-}"
[[ -z "$PW" ]] && { echo "Usage: $0 '<password>'" >&2; exit 2; }

if command -v caddy >/dev/null; then
  caddy hash-password --plaintext "$PW"
elif command -v docker >/dev/null; then
  docker run --rm caddy:2-alpine caddy hash-password --plaintext "$PW"
elif command -v htpasswd >/dev/null; then
  htpasswd -bnBC 10 "" "$PW" | tr -d ':\n'
  echo
else
  echo "❌ Need one of: caddy, docker, or htpasswd" >&2
  exit 1
fi
