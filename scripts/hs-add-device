#!/usr/bin/env bash
###############################################################################
# hs-add-device — one-command device onboarding.
# Usage: ./hs-add-device <username> [--reusable] [--ephemeral] [--ttl 24h] [--tags tag:laptop]
# Auto-detects Docker Compose / Kubernetes / local binary.
###############################################################################
set -euo pipefail

USER="${1:-}"; shift || true
REUSABLE="false"; EPHEMERAL="false"; TTL="24h"; TAGS=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --reusable)  REUSABLE="true"; shift ;;
    --ephemeral) EPHEMERAL="true"; shift ;;
    --ttl)       TTL="$2"; shift 2 ;;
    --tags)      TAGS="$2"; shift 2 ;;
    *) echo "Unknown flag: $1" >&2; exit 2 ;;
  esac
done

[[ -z "$USER" ]] && { echo "Usage: $0 <username> [--reusable] [--ephemeral] [--ttl 24h] [--tags tag:laptop]" >&2; exit 2; }

run_hs() {
  if [[ -n "${HS_BIN:-}" ]]; then
    "$HS_BIN" "$@"
  elif command -v kubectl >/dev/null && kubectl get pods -n "${HS_KUBE_NS:-headscale}" -l app.kubernetes.io/name=headscale,app.kubernetes.io/component=control-plane -o name 2>/dev/null | grep -q .; then
    POD=$(kubectl get pods -n "${HS_KUBE_NS:-headscale}" -l app.kubernetes.io/name=headscale,app.kubernetes.io/component=control-plane -o jsonpath='{.items[0].metadata.name}')
    kubectl exec -n "${HS_KUBE_NS:-headscale}" "$POD" -- headscale "$@"
  elif docker compose ps headscale --quiet >/dev/null 2>&1; then
    docker compose exec -T headscale headscale "$@"
  elif [[ -f compose/docker-compose.yml ]] && docker compose -f compose/docker-compose.yml ps headscale --quiet >/dev/null 2>&1; then
    docker compose -f compose/docker-compose.yml exec -T headscale headscale "$@"
  elif [[ -f ../compose/docker-compose.yml ]] && docker compose -f ../compose/docker-compose.yml ps headscale --quiet >/dev/null 2>&1; then
    docker compose -f ../compose/docker-compose.yml exec -T headscale headscale "$@"
  else
    echo "❌ Could not detect a running headscale (binary / compose / k8s)." >&2
    exit 1
  fi
}

# Source .env automatically if it exists to get HEADSCALE_DOMAIN and SCHEME
for env_file in ".env" "compose/.env" "../compose/.env"; do
  if [[ -f "$env_file" ]]; then
    set -a; source "$env_file"; set +a
    break
  fi
done

SCHEME="${HEADSCALE_URL_SCHEME:-https}"
if [[ -n "${HEADSCALE_DOMAIN:-}" ]]; then
  SERVER_URL="${SCHEME}://${HEADSCALE_DOMAIN}"
else
  SERVER_URL=$(run_hs configtest 2>/dev/null | awk -F': ' '/server_url/ {print $2; exit}' || true)
fi
: "${SERVER_URL:?Set HEADSCALE_DOMAIN or configure server_url}"

if ! run_hs users list --output json | grep -q "\"name\":\"${USER}\""; then
  echo "→ Creating headscale user: $USER"
  run_hs users create "$USER" >/dev/null
fi

# Headscale >= 0.23 requires numeric User ID for preauthkeys create
if command -v jq >/dev/null 2>&1; then
  USER_ID=$(run_hs users list --output json | jq -r ".[] | select(.name == \"$USER\") | .id")
elif command -v python3 >/dev/null 2>&1; then
  USER_ID=$(run_hs users list --output json | python3 -c "import sys, json; data = json.load(sys.stdin); print(next((str(u['id']) for u in data if u['name'] == '$USER'), ''))")
else
  USER_ID=$(run_hs users list | grep -E "\b${USER}\b" | awk '{print $1}' | grep -E '^[0-9]+$' | head -n 1)
fi

if [[ -z "$USER_ID" || ! "$USER_ID" =~ ^[0-9]+$ ]]; then
  echo "❌ Could not determine numeric ID for user $USER. Ensure jq or python3 is installed." >&2
  exit 1
fi

FLAGS=(--user "$USER_ID" --expiration "$TTL")
[[ "$REUSABLE"  == "true" ]] && FLAGS+=(--reusable)
[[ "$EPHEMERAL" == "true" ]] && FLAGS+=(--ephemeral)
[[ -n "$TAGS" ]]              && FLAGS+=(--tags "$TAGS")

KEY=$(run_hs preauthkeys create "${FLAGS[@]}" --output json | sed -E 's/.*"key":"([^"]+)".*/\1/')

CMD="tailscale up --login-server ${SERVER_URL} --authkey ${KEY}"
IOS_URL="tailscale://login-server=${SERVER_URL}&authkey=${KEY}"

cat <<EOF

╭──────────────────────────────────────────────────────────────────────╮
│  ✅ Device onboarding token ready for user: ${USER}
│  Expires in: ${TTL}
╰──────────────────────────────────────────────────────────────────────╯

▸ Linux / macOS / Windows:
    ${CMD}

▸ iOS / Android — scan QR (needs \`qrencode\`):
EOF

if command -v qrencode >/dev/null 2>&1; then
  qrencode -t ANSIUTF8 "$IOS_URL"
else
  echo "   (install \`qrencode\` for inline QR; or open on phone:)"
  echo "   $IOS_URL"
fi

cat <<EOF

▸ Deep-link: ${IOS_URL}
▸ Web UI:    ${SERVER_URL}/web

EOF
