# Automatic HTTPS via Let's Encrypt.
#   /web/*  →  headscale-ui:8080   (Basic Auth disabled — see Caddyfile.auth)
#   /*      →  headscale:8080      (API — always anonymous; clients need it)
#
# This variant is loaded when UI_BASIC_AUTH_HASH is empty. To enable UI
# auth, set UI_BASIC_AUTH_USER/HASH in .env — the caddy container's
# entrypoint will swap in Caddyfile.auth instead.

{
    email {$ACME_EMAIL}
}

{$HEADSCALE_URL_SCHEME:https}://{$HEADSCALE_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "no-referrer"
        -Server
    }

    handle /web* {
        reverse_proxy headscale-ui:8080
    }

    handle {
        reverse_proxy headscale:8080 {
            header_up Host              {host}
            header_up X-Real-IP         {remote}
            header_up X-Forwarded-For   {remote}
            header_up X-Forwarded-Proto {$HEADSCALE_URL_SCHEME:https}
        }
    }
}
