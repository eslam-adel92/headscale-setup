###############################################################################
# .env.example — Docker Compose stack
# Copy to `.env` and fill in. NEVER commit the resulting .env.
###############################################################################

# ─── Public HTTPS ──────────────────────────────────────────────────────
HEADSCALE_DOMAIN=hs.example.com
ACME_EMAIL=admin@example.com

# ─── Images ────────────────────────────────────────────────────────────
# Point at wherever the GHA workflow pushed them.
HEADSCALE_IMAGE=ghcr.io/your-org/headscale:0.29.1
HEADSCALE_UI_IMAGE=ghcr.io/your-org/headscale-ui:2026-03-17
POSTGRES_IMAGE=postgres:16-alpine

# ─── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_DB=headscale
POSTGRES_USER=headscale
# ⚠️  Required. Generate:  openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_32

POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEM_LIMIT=1G
POSTGRES_CPU_REQ=0.25
POSTGRES_MEM_REQ=256M

# ─── UI Basic Auth (optional) ──────────────────────────────────────────
# Leave UI_BASIC_AUTH_HASH empty to disable. To enable, generate a bcrypt
# hash and paste below:
#   ./scripts/hs-hash-ui-password 'yourPassword'
UI_BASIC_AUTH_USER=admin
UI_BASIC_AUTH_HASH=

# ─── Backups (optional profile) ────────────────────────────────────────
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=14

# ─── Misc ──────────────────────────────────────────────────────────────
TZ=UTC
